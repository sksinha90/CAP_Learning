{
    "name": "soapplication",
    "version": "1.0.0",
    "description": "A simple CAP project.",
    "repository": "<Add your repository here>",
    "license": "UNLICENSED",
    "private": true,
    "dependencies": {
        "@cap-js-community/odata-v2-adapter": "^1.11.6",
        "@sap/cds": "^7",
        "@sap/cds-hana": "^2",
        "@sap/xssec": "^3",
        "express": "^4",
        "hdb": "^0.19.5",
        "passport": "^0"
    },
    "devDependencies": {
        "@cap-js/sqlite": "^1",
        "@sap/cds-dk": "^7",
        "@sap/ux-specification": "^1.108.11",
        "rimraf": "^3.0.2"
    },
    "scripts": {
        "start": "cds-serve",
        "watch-material": "cds watch --open material/webapp/index.html?sap-ui-xx-viewCache=false",
        "undeploy": "cf undeploy soapplication --delete-services --delete-service-keys --delete-service-brokers",
        "build": "rimraf resources mta_archives && mbt build --mtar archive",
        "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
        "watch-customer": "cds watch --open customer/webapp/index.html?sap-ui-xx-viewCache=false",
        "watch-salesorder": "cds watch --open salesorder/webapp/index.html?sap-ui-xx-viewCache=false"
    },
    "cds": {
        "requires": {
            "db": {
                "kind": "hana"
            },
            "[production]": {
                "auth": "xsuaa"
            },
            "auth": "xsuaa"
        }
    },
    "sapux": [
        "app/material",
        "app/customer",
        "app/salesorder"
    ]
}
